---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Diagram from "../../components/Diagram.astro";
import { SITE } from "../../data/site";

export async function getStaticPaths() {
  const works = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
  return works.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: works[(i + 1) % works.length] },
  }));
}

const { entry, next } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;

// The fixed section menu: the diagram, then each h2 in the write-up.
const sections = [
  { href: "#architecture", label: "Diagram" },
  ...headings.filter((h) => h.depth === 2).map((h) => ({ href: `#${h.slug}`, label: h.text })),
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    name: d.title,
    description: d.description,
    author: { "@type": "Person", name: SITE.name },
    keywords: d.stack.join(", "),
    url: new URL(Astro.url.pathname, Astro.site).href,
  },
];
---

<BaseLayout title={`${d.title} | ${SITE.name}`} description={d.description} jsonLd={jsonLd}>
  <article>
    <header class="wrap head">
      <a class="back" href="/#work">All work</a>
      <h1>{d.title}</h1>
      <p class="lead">{d.summary}</p>
      <dl class="facts">
        <div>
          <dt>Context</dt>
          <dd>{d.context}{d.period && `, ${d.period}`}</dd>
        </div>
        <div>
          <dt>Stack</dt>
          <dd class="mono">{d.stack.join(", ")}</dd>
        </div>
        {
          (d.repo || d.demo) && (
            <div>
              <dt>Links</dt>
              <dd>
                {d.repo && <a href={d.repo}>Code</a>}
                {d.repo && d.demo && ", "}
                {d.demo && <a href={d.demo}>Demo</a>}
              </dd>
            </div>
          )
        }
      </dl>
    </header>

    <nav class="onpage" aria-label="On this page">
      <ul class="wrap">
        {sections.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
      </ul>
    </nav>

    <div class="wrap body">
      <section id="architecture" class="diagrams" aria-label="Architecture">
        {d.diagrams.map((diagram) => <Diagram diagram={diagram} variant="column" />)}
      </section>
      <div class="prose">
        <Content />
      </div>
    </div>

    <nav class="wrap next" aria-label="Next case study">
      <span class="meta">Next</span>
      <a href={`/work/${next.id}/`}>{next.data.title}</a>
    </nav>
  </article>
</BaseLayout>

<script>
  // Mark the section being read in the fixed section menu.
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".onpage a")];
  const targets = links
    .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
    .filter((el): el is HTMLElement => el !== null);

  function mark() {
    const line = 150;
    let current = targets[0];
    for (const t of targets) if (t.getBoundingClientRect().top <= line) current = t;
    // On wide screens the diagram sits beside the text, so the text wins once it starts.
    links.forEach((a) => {
      if (current && a.hash === `#${current.id}`) a.setAttribute("aria-current", "true");
      else a.removeAttribute("aria-current");
    });
  }

  if (targets.length) {
    mark();
    addEventListener("scroll", mark, { passive: true });
  }
</script>

<style>
  /* Fixed section menu, under the site header */
  .onpage {
    position: sticky;
    top: 3.5rem;
    z-index: 5;
    background: var(--bg);
    border-block: 1px solid var(--line);
  }

  .onpage ul {
    display: flex;
    gap: var(--s-6);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .onpage ul::-webkit-scrollbar {
    display: none;
  }

  .onpage a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--step-small);
    color: var(--text-2);
    text-decoration: none;
    white-space: nowrap;
    box-shadow: inset 0 -2px 0 transparent;
    transition: color var(--fast) var(--ease), box-shadow var(--fast) var(--ease);
  }

  .onpage a:hover {
    color: var(--text);
  }

  .onpage a[aria-current="true"] {
    color: var(--text);
    box-shadow: inset 0 -2px 0 var(--accent);
  }

  .body {
    padding-top: var(--s-10);
  }

  .diagrams,
  .prose :global(h2) {
    /* Adds to the page's scroll-padding so headings clear both sticky bars. */
    scroll-margin-top: 2.5rem;
  }

  .head {
    display: grid;
    gap: var(--s-5);
    padding-block: var(--s-12) var(--s-8);
  }

  .head h1 {
    font-size: clamp(2.25rem, 1.5rem + 3.6vw, 3.75rem);
    max-width: 18ch;
  }

  .head .lead {
    max-width: var(--measure);
  }

  .back {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--step-small);
    color: var(--text-2);
  }

  .facts {
    display: grid;
    gap: var(--s-3);
    margin: var(--s-3) 0 0;
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
    font-size: var(--step-small);
  }

  .facts div {
    display: grid;
    gap: var(--s-1);
  }

  .facts dt {
    color: var(--muted);
  }

  .facts dd {
    color: var(--text);
  }

  .body {
    display: grid;
    gap: var(--s-12);
    padding-bottom: var(--s-16);
  }

  .diagrams {
    display: grid;
    gap: var(--s-10);
    align-content: start;
  }

  .next {
    display: grid;
    gap: var(--s-1);
    padding-block: var(--s-10);
    border-top: 1px solid var(--line);
  }

  .next a {
    justify-self: start;
    font-size: var(--step-h3);
    font-weight: 500;
    font-stretch: 84%;
    line-height: 1.2;
  }

  @media (min-width: 40rem) {
    .facts div {
      grid-template-columns: 8rem 1fr;
      gap: var(--s-4);
    }
  }

  @media (min-width: 64rem) {
    .head {
      padding-block: var(--s-20) var(--s-12);
    }

    .body {
      grid-template-columns: minmax(0, 30rem) minmax(0, 1fr);
      gap: var(--s-16);
      align-items: start;
      padding-bottom: var(--s-24);
    }

  }
</style>
