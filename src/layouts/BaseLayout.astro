---
import "@fontsource-variable/instrument-sans/wdth.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "../styles/tokens.css";
import "../styles/base.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../data/site";
import { SKILLS } from "../data/skills";

interface Props {
  title?: string;
  description?: string;
  jsonLd?: Record<string, unknown>[];
}

const { title = SITE.title, description = SITE.description, jsonLd = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-default.jpg", Astro.site).href;
const ogAlt =
  "Dhanashri Sonawane, software engineer building generative AI products, beside a pipeline diagram: request, input guardrail, model call, validation, output.";

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.name,
  jobTitle: SITE.jobTitle,
  url: Astro.site?.href,
  email: `mailto:${SITE.email}`,
  address: { "@type": "PostalAddress", addressLocality: "Pune", addressCountry: "IN" },
  sameAs: [SITE.github, SITE.linkedin],
  knowsAbout: SKILLS.flatMap((g) => g.items).slice(0, 24),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#111614" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script is:inline>
      try {
        // Dark is the default. Light applies only if the visitor chose it.
        // A link can also ask for it with ?theme=light.
        const asked = new URLSearchParams(location.search).get("theme");
        if (asked === "light" || (asked !== "dark" && localStorage.getItem("theme") === "light"))
          document.documentElement.dataset.theme = "light";
      } catch {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    {jsonLd.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
